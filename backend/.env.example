# ==============================================================================
# JEE InsightAI — Backend Environment Configuration Template
# ==============================================================================

# Database Connection
# Local Development (Default): SQLite file in backend directory
DATABASE_URL=sqlite:///./jee_insight.db

# Production / PostgreSQL Setup (When PostgreSQL service is running):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/jee_insight_ai

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
API_PREFIX=/api/v1

# Security & Session Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==============================================================================
# AI Performance Coach & LLM Configuration (Stage 5 Google Gemini)
# ==============================================================================
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
# Leave empty or comment out to run in transparent local diagnostic fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30.0

